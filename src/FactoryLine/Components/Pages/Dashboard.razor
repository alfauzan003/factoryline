@page "/"
@implements IAsyncDisposable
@using FactoryLine.Data
@using FactoryLine.Services

<PageTitle>FactoryLine — Live equipment dashboard</PageTitle>

<h1>Live equipment dashboard</h1>
<p class="muted">
    Equipment states are produced by the line simulator and flow through the equipment bridge
    (normalize → persist to SQL Server → SignalR). Updates appear here without a page refresh.
</p>

<div class="controls">
    <button class="btn" disabled="@(_running)" @onclick="StartLine">Start line</button>
    <button class="btn btn-danger" disabled="@(!_running)" @onclick="StopLine">Stop line</button>
</div>

@if (_states is null)
{
    <p class="muted">Loading…</p>
}
else if (_states.Count == 0)
{
    <p class="muted">No equipment configured. Check the <code>LineSimulator:EquipmentCount</code> setting.</p>
}
else
{
    <table class="equipment-table">
        <thead>
            <tr>
                <th>Equipment</th>
                <th>State</th>
                <th>Changed at</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var state in _states)
            {
                <tr>
                    <td>@state.EquipmentId</td>
                    <td><span class="badge badge-@state.State">@state.State</span></td>
                    <td>@state.ChangedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Work orders</h2>
<p class="muted">
    Create a work order; the equipment holds in WAIT_MATERIAL until the arrival callback for its
    required material releases the gate, then production auto-starts.
</p>

<div class="wo-form">
    <input class="input" placeholder="Product code" @bind="_productCode" />
    <input class="input" placeholder="Required material" @bind="_requiredMaterial" />
    <input class="input" placeholder="Equipment (e.g. EQ-01)" @bind="_equipmentId" />
    <button class="btn" @onclick="CreateWorkOrder">Create work order</button>
</div>

@if (_workOrders is not null)
{
    <table class="equipment-table">
        <thead>
            <tr>
                <th>Work order</th>
                <th>Product</th>
                <th>Material</th>
                <th>Equipment</th>
                <th>State</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wo in _workOrders)
            {
                <tr>
                    <td>@wo.Id[..8]</td>
                    <td>@wo.ProductCode</td>
                    <td>@wo.RequiredMaterialId</td>
                    <td>@wo.EquipmentId</td>
                    <td><span class="badge badge-@wo.State">@wo.State</span></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private HubConnection? _hub;
    private List<EquipmentStateSnapshot> _states = new();
    private List<WorkOrderRow> _workOrders = new();
    private bool _running;
    private string _productCode = "BAT-100";
    private string _requiredMaterial = "CELL-X";
    private string _equipmentId = "EQ-01";

    [Inject]
    private IEquipmentSource Source { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Inject]
    private MiniMesService MiniMes { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _running = Source.IsRunning;

        var current = await Source.GetCurrentStatesAsync();
        _states = current.ToList();

        _workOrders = await MiniMes.GetWorkOrdersAsync();

        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/equipmenthub"))
            .Build();

        _hub.On<EquipmentStateChange>("EquipmentStateChanged", change =>
        {
            var snapshot = new EquipmentStateSnapshot(change.EquipmentId, change.State, change.Timestamp);
            var index = _states.FindIndex(s => s.EquipmentId == snapshot.EquipmentId);
            if (index >= 0)
            {
                _states[index] = snapshot;
            }
            else
            {
                _states.Add(snapshot);
            }

            InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
    }

    private async Task StartLine()
    {
        await Source.StartAsync();
        _running = Source.IsRunning;
    }

    private async Task StopLine()
    {
        await Source.StopAsync();
        _running = Source.IsRunning;
    }

    private async Task CreateWorkOrder()
    {
        await MiniMes.CreateWorkOrderAsync(new CreateWorkOrderRequest(_productCode, _requiredMaterial, _equipmentId));
        _workOrders = await MiniMes.GetWorkOrdersAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
